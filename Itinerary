    let currentDayIndex = 0;
    let currentFilter = 'all';

    // Initialize App
    function initApp() {
      renderDayTabs();
      renderDayContent(currentDayIndex);
      lucide.createIcons();
    }

    // Render Navigation Tabs
    function renderDayTabs() {
      const container = document.getElementById('dayTabsContainer');
      container.innerHTML = itineraryData.map((d, idx) => `
        <button class="day-tab ${idx === currentDayIndex ? 'active' : ''}" onclick="selectDay(${idx})">
          <span class="tab-date">${d.date}</span>
          <span class="tab-day">${d.day}</span>
        </button>
      `).join('');
    }

    // Select Day Function
    function selectDay(index) {
      currentDayIndex = index;
      renderDayTabs();
      renderDayContent(index);
      lucide.createIcons();
      window.scrollTo({ top: 120, behavior: 'smooth' });
    }

    // Render Day Hero, Timeline and Budget
    function renderDayContent(index) {
      const data = itineraryData[index];

      // Render Hero Card
      const hero = document.getElementById('dayHero');
      hero.innerHTML = `
        <div class="city-info">
          <h2>${data.city}</h2>
          <p><i data-lucide="map-pin" style="width:14px; height:14px;"></i> ${data.cityJp}</p>
        </div>
        <div class="outfit-badge">
          <span style="font-size:0.68rem; color:#64748b; font-weight:700; margin-bottom:4px;">DRESS THEME</span>
          <div class="outfit-pill" style="background:${data.themeBg}; color:${data.themeColor};">
            <i data-lucide="sparkles" style="width:12px; height:12px;"></i>
            <span>${data.theme}</span>
          </div>
        </div>
      `;

      // Render Timeline Events
      const timeline = document.getElementById('timelineContainer');
      let filteredEvents = data.events;

      if (currentFilter === 'hotel') {
        filteredEvents = data.events.filter(e => e.type === 'stay');
      } else if (currentFilter === 'transit') {
        filteredEvents = data.events.filter(e => ['train', 'bus', 'flight', 'car'].includes(e.type));
      }

      if (filteredEvents.length === 0) {
        timeline.innerHTML = `<p style="padding:20px; color:#64748b; font-size:0.9rem;">No entries found for this category today.</p>`;
      } else {
        timeline.innerHTML = filteredEvents.map(event => `
          <div class="event-card ${event.type}">
            <div class="event-time-row">
              <span class="time-tag">
                <i data-lucide="clock" style="width:13px; height:13px;"></i>
                ${event.time}
              </span>
              <span class="type-chip ${event.type}">${event.transportType || event.type}</span>
            </div>
            <div class="event-title">${event.title}</div>
            <div class="event-subtext">${event.details}</div>
            ${event.cost ? `<div class="cost-badge">${event.cost}</div>` : ''}
            ${event.note ? `<div class="notice-box"><i data-lucide="alert-circle" style="width:12px; height:12px; display:inline-block; vertical-align:middle; margin-right:3px;"></i>${event.note}</div>` : ''}
          </div>
        `).join('');
      }

      // Render Budget Box
      const budgetBox = document.getElementById('budgetSummaryBox');
      budgetBox.innerHTML = `
        <div class="budget-info">
          <h4>Estimated Day Total</h4>
          <p>RM ${data.totalDayRM || '0.00'}</p>
        </div>
        <div style="text-align:right;">
          <span style="font-size:0.75rem; color:#64748b; display:block;">Overnight Stay:</span>
          <span style="font-size:0.85rem; font-weight:700; color:#1e293b;">${data.hotel || 'In-Flight / Return'}</span>
        </div>
      `;
    }

    // Filter Tool Functions
    function filterByTag(tag) {
      currentFilter = tag;
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      event.currentTarget.classList.add('active');
      renderDayContent(currentDayIndex);
      lucide.createIcons();
    }

    function resetView() {
      currentFilter = 'all';
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelector('.nav-btn:first-child').classList.add('active');
      renderDayContent(currentDayIndex);
      lucide.createIcons();
    }

    function openExpenseOverview() {
      alert("📊 Budget Overview:\nTotal calculated daily expenses are detailed per card in both Japanese Yen (¥) and Malaysian Ringgit (RM).");
    }

    // Real-time Search Filter
    function handleSearch() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      if (!query) {
        renderDayContent(currentDayIndex);
        lucide.createIcons();
        return;
      }

      const timeline = document.getElementById('timelineContainer');
      const allMatching = [];

      itineraryData.forEach(day => {
        day.events.forEach(ev => {
          if (ev.title.toLowerCase().includes(query) || 
              ev.details.toLowerCase().includes(query) ||
              day.city.toLowerCase().includes(query)) {
            allMatching.push({ ...ev, date: day.date, dayOfWeek: day.day });
          }
        });
      });

      if (allMatching.length === 0) {
        timeline.innerHTML = `<div style="padding:20px; text-align:center; color:#64748b;">No matching itinerary item for "${query}"</div>`;
      } else {
        timeline.innerHTML = allMatching.map(ev => `
          <div class="event-card ${ev.type}">
            <div class="event-time-row">
              <span class="time-tag">${ev.date} (${ev.dayOfWeek}) • ${ev.time}</span>
              <span class="type-chip ${ev.type}">${ev.type}</span>
            </div>
            <div class="event-title">${ev.title}</div>
            <div class="event-subtext">${ev.details}</div>
            ${ev.cost ? `<div class="cost-badge">${ev.cost}</div>` : ''}
          </div>
        `).join('');
      }
      lucide.createIcons();
    }

    // Start script
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
