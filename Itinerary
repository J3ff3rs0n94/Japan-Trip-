  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --primary: #c93b2b;       /* Maple crimson */
      --primary-light: #fef2f2;
      --accent: #d97706;        /* Golden ginkgo */
      --dark: #1e293b;
      --gray-bg: #f8fafc;
      --card-bg: #ffffff;
      --border: #e2e8f0;
      --text-muted: #64748b;
      --radius: 16px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.07), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Plus Jakarta Sans', 'Noto Sans JP', sans-serif;
      background-color: var(--gray-bg);
      color: var(--dark);
      line-height: 1.5;
      padding-bottom: 90px;
    }

    /* Top App Bar */
    header {
      background: linear-gradient(135deg, #991b1b 0%, #dc2626 60%, #ea580c 100%);
      color: white;
      padding: 2.2rem 1.25rem 1.5rem;
      border-radius: 0 0 28px 28px;
      box-shadow: 0 10px 25px -5px rgba(220, 38, 38, 0.3);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-content {
      max-width: 680px;
      margin: 0 auto;
    }

    .badge-capsule {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(8px);
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    h1 {
      font-size: 1.65rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .subtitle {
      font-size: 0.88rem;
      opacity: 0.9;
      margin-top: 4px;
    }

    /* Overall Summary Stats */
    .trip-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 18px;
      background: rgba(255,255,255,0.14);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 10px 14px;
    }

    .stat-item {
      text-align: center;
    }

    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.85;
    }

    .stat-val {
      font-size: 1.05rem;
      font-weight: 700;
    }

    /* Navigation Container */
    .container {
      max-width: 680px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* Day Scroller Tabs */
    .day-selector-wrapper {
      margin-top: -18px;
      margin-bottom: 20px;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding: 6px 0;
    }
    .day-selector-wrapper::-webkit-scrollbar { display: none; }

    .day-tabs {
      display: inline-flex;
      gap: 8px;
      background: white;
      padding: 6px;
      border-radius: 999px;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--border);
    }

    .day-tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 8px 16px;
      border-radius: 999px;
      background: transparent;
      border: none;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .day-tab .tab-date {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .day-tab .tab-day {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--dark);
    }

    .day-tab.active {
      background: var(--primary);
      box-shadow: 0 4px 12px rgba(201, 59, 43, 0.35);
    }

    .day-tab.active .tab-date,
    .day-tab.active .tab-day {
      color: white;
    }

    /* Theme & City Banner */
    .day-hero-card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 1.25rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .day-hero-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 6px;
      background: var(--primary);
    }

    .city-info h2 {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--dark);
    }

    .city-info p {
      font-size: 0.82rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 3px;
    }

    .outfit-badge {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }

    .outfit-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      border: 1px solid rgba(0,0,0,0.08);
      text-transform: capitalize;
    }

    /* Timeline Section */
    .timeline {
      position: relative;
      margin-left: 10px;
      padding-left: 24px;
      border-left: 2.5px dashed #cbd5e1;
    }

    .event-card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 1rem 1.15rem;
      margin-bottom: 16px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      position: relative;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .event-card:hover {
      box-shadow: var(--shadow-md);
    }

    /* Node Marker */
    .event-card::before {
      content: '';
      position: absolute;
      left: -33px;
      top: 18px;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: white;
      border: 3.5px solid var(--primary);
      box-shadow: 0 0 0 2px rgba(255,255,255,1);
    }

    .event-card.stay::before {
      border-color: #3b82f6;
    }

    .event-card.food::before {
      border-color: #10b981;
    }

    .event-time-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .time-tag {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--primary);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .type-chip {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: 6px;
      font-weight: 600;
      background: #f1f5f9;
      color: #475569;
      text-transform: uppercase;
    }

    .type-chip.flight { background: #e0f2fe; color: #0284c7; }
    .type-chip.train { background: #fef3c7; color: #b45309; }
    .type-chip.bus { background: #ede9fe; color: #7c3aed; }
    .type-chip.car { background: #dcfce7; color: #15803d; }
    .type-chip.stay { background: #dbeafe; color: #1d4ed8; }

    .event-title {
      font-size: 1.02rem;
      font-weight: 700;
      color: var(--dark);
      line-height: 1.35;
    }

    .event-subtext {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .route-spec {
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 8px;
      background: #f8fafc;
      font-size: 0.78rem;
      border: 1px solid #f1f5f9;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .spec-item {
      display: flex;
      justify-content: space-between;
      color: #475569;
    }

    .spec-val {
      font-weight: 600;
      color: var(--dark);
      text-align: right;
    }

    .cost-badge {
      display: inline-block;
      margin-top: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      color: #047857;
      background: #ecfdf5;
      padding: 2px 8px;
      border-radius: 6px;
    }

    .notice-box {
      margin-top: 8px;
      font-size: 0.78rem;
      color: #b91c1c;
      background: #fef2f2;
      border-left: 3px solid #dc2626;
      padding: 6px 8px;
      border-radius: 4px;
    }

    /* Day Budget Summary Footer */
    .day-budget-box {
      margin-top: 24px;
      background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .budget-info h4 {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .budget-info p {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--dark);
    }

    /* Quick Filter & Emergency Tools */
    .quick-bar {
      margin: 18px 0;
      display: flex;
      gap: 8px;
    }

    .search-input {
      flex: 1;
      padding: 10px 14px 10px 36px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: white;
      font-size: 0.85rem;
      outline: none;
      box-shadow: var(--shadow-sm);
    }

    .search-wrapper {
      position: relative;
      flex: 1;
    }

    .search-wrapper i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      width: 16px;
      height: 16px;
    }

    /* Fixed Bottom Navigation */
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--border);
      padding: 8px 1rem calc(8px + env(safe-area-inset-bottom));
      display: flex;
      justify-content: space-around;
      z-index: 100;
    }

    .nav-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
    }

    .nav-btn.active {
      color: var(--primary);
    }

    .nav-btn i {
      width: 20px;
      height: 20px;
    }
  </style>
</head>
